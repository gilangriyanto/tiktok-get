# true = pakai data mock di src/mocks (API asli belum ada).
# Mock juga otomatis dipakai jika NEXT_PUBLIC_API_URL kosong.
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_URL=http://localhost:4000

# Hanya untuk mock: status campaign.
#   kosong   = active (default, agar semua halaman bisa dicoba)
#   upcoming | ended | active = paksa status
#   dates    = pakai startAt/endAt asli dari data mock
NEXT_PUBLIC_MOCK_CAMPAIGN_STATE=
