# true = pakai data mock di memori (src/lib/mock). Mock juga dipakai jika NEXT_PUBLIC_API_URL kosong.
NEXT_PUBLIC_USE_MOCK=true
# Base URL apps/api; CMS memanggil {NEXT_PUBLIC_API_URL}/admin/...
NEXT_PUBLIC_API_URL=http://localhost:4000
# Domain microsite untuk generator link TikTok (FR-CMS-06).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
